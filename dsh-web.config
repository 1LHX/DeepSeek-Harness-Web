# dsh-web.config - shared configuration for dsh-panel.exe / start-service.ps1 / stop-dsh.cmd
# Keep this file ASCII only (PowerShell 5.1 reads it without a BOM).
# Lines starting with # are comments. Format: key=value
# The panel builds the URL from the port (http://127.0.0.1:<port>).

port=3080

# Workbench workspace override (optional). Empty = the panel folder itself.
# Keep this file ASCII only: non-ASCII paths must use the in-app workspace picker.
# workspace=C:\Users\me\projects\demo

# Embedded browser remote debugging port (WebView2 / CDP). DEV ONLY, default off.
# While it is on, any local process can attach to the embedded browser and therefore
# drive the workbench bridge (file writes, terminal). Leave it commented out.
# debugport=9222

# V8 compile cache for the service process (hooks/compile-cache.mjs).
# 1 = on, 0 or unset = off. The hook is probed before use and the launcher retries
# without it if it ever fails, so enabling this cannot keep the service down.
# Measured 2026-10-29: no gain while the file cache was warm (1.89 s vs 1.89 s);
# enabled to see whether it helps the cold path now that _npx is excluded from
# antivirus scanning. Compare "PORT READY" in run/boot-timing.log after a reboot.
compilecache=1
