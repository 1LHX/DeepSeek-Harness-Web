# dsh-web panel - git ignore rules

# ---- runtime artifacts (v1.4+) ----
logs/
run/
*.log
*.pid

# ---- WebView2 runtime DLLs next to the exe (build copies them from lib/) ----
/Microsoft.Web.WebView2.Core.dll
/Microsoft.Web.WebView2.WinForms.dll
/WebView2Loader.dll

# ---- DSH harness tooling data (not project assets) ----
.mimosa/

# ---- editor / OS noise ----
.vscode/
.idea/
.zcode/
Thumbs.db
Desktop.ini

# Note: dsh-panel.exe and dsh-panel.ico are committed on purpose -
# this is a portable, copy-and-run tool; the artifacts are the distribution.
